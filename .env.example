# Runtime application role. It must be non-owner and must not receive
# BYPASSRLS when tenant policies are introduced in Slice 1C.
DATABASE_URL=postgresql://seller_shield_app:change-me@localhost:5432/seller_shield

# Migration-owner role. Never use this connection in the running application.
DATABASE_MIGRATION_URL=postgresql://seller_shield_migrator:change-me@localhost:5432/seller_shield

# Server-only Better Auth configuration; replace the placeholder with a random secret.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
