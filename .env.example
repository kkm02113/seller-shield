# Runtime application role. It must be non-owner and must not receive
# BYPASSRLS when tenant policies are introduced in Slice 1C.
DATABASE_URL=postgresql://seller_shield_app:change-me@localhost:5432/seller_shield

# Migration-owner role. Never use this connection in the running application.
DATABASE_MIGRATION_URL=postgresql://seller_shield_migrator:change-me@localhost:5432/seller_shield

# Test process ONLY: existing setup administrator on a dedicated local/test DB.
# Required for tenancy constraint fixtures; never configure in the app/deployment.
# No runtime/migration fallback, no new bypass role. Supply separately when running test:db.
# DATABASE_TEST_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/seller_shield

# Provisioning process ONLY: existing setup administrator on the same DB.
# Required to prepare/finalize the NOLOGIN bootstrap helper; never app/deployment.
# DATABASE_PROVISION_URL=postgresql://postgres:change-me@localhost:5432/seller_shield

# DB/browser tests reject non-*_test database names by default. For an existing
# dedicated synthetic LOOPBACK DB only, supply BOTH in the test process; do not
# persist these in any .env file (file opt-ins are ignored). Match URL host/port/name.
# Test URL query options are rejected, including database/user overrides.
# ALLOW_DESTRUCTIVE_DB_TESTS=1
# DATABASE_TEST_TARGET=localhost:5432/seller_shield

# Server-only Better Auth configuration; replace the placeholder with a random secret.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Required only for actual email delivery; public shell/build/capture tests do not need these.
# Use a verified Resend domain (Tokyo sending region, open/click tracking OFF).
RESEND_API_KEY=re_replace-with-your-server-api-key
AUTH_EMAIL_FROM=auth@your-domain.example
